        "dataSourceId": "c5f76ee9-8b0b-4b09-914c-ab8f8984edd6"
      },
      "text": "raw_events\n| extend timestamp=datetime_utc_to_local(timestamp,'Europe/Madrid')\n| where timestamp between (startofday(_eventDate)..endofday(_eventDate))",
