  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c5f76ee9-8b0b-4b09-914c-ab8f8984edd6"
      },
      "text": "let _users = currentSession(startofday(_eventDate))\n| project userName;\n_users\n| union (datatable(userName:string)[\"Waiting for Players\"] | where toscalar(_users | count ) == 0)",
      "id": "22cc2846-1768-4e87-aba8-c0bf95321278",
      "usedVariables": [
        "_eventDate"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c5f76ee9-8b0b-4b09-914c-ab8f8984edd6"
      },
      "text": "_todaysevents\n    | where eventName == \"game.answerquestion\"\n    | sort by timestamp\n    | limit 100\n    | extend Rtime = toint(properties.responseTime)/1000\n    ",
      "id": "846fe032-2836-4bb8-b0c0-ecc5b484d22f",
      "usedVariables": [
        "_todaysevents"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c5f76ee9-8b0b-4b09-914c-ab8f8984edd6"
      },
      "text": "_todaysevents\n    | where eventName == \"game.answerquestion\"\n    | extend category = tostring(properties.category)\n    | extend answer = case (tobool(properties.isCorrect)== true, \"correct\", \"incorrect\")\n    | summarize count() by category, answer\n    | sort by category asc\n",
      "id": "d6eafb1e-0f28-4274-a869-72cc1d274e83",
      "usedVariables": [
        "_todaysevents"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c5f76ee9-8b0b-4b09-914c-ab8f8984edd6"
      },
      "text": "let name=\n_todaysevents\n    | where eventName == \"user.register\"\n    | distinct userId, userName = tostring(properties.name);\n_todaysevents\n| where eventName == \"game.answerquestion\"\n| where tobool(properties.isCorrect) == true\n| summarize responseTime=strcat(round(avg(toint(properties.responseTime))), \" ms\") by userId\n| lookup name on userId\n| sort by responseTime asc\n| limit 3\n",
      "id": "7e5e726d-ab12-4a01-9b4c-6605ae725b8c",
      "usedVariables": [
        "_todaysevents"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c5f76ee9-8b0b-4b09-914c-ab8f8984edd6"
      },
      "text": "allSessions(_eventDate)\n| summarize count() by pool",
      "id": "973cd37e-093f-484f-9a48-1d378ae6b5e6",
      "usedVariables": [
        "_eventDate"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c5f76ee9-8b0b-4b09-914c-ab8f8984edd6"
      },
      "text": "let stationMap=\n    raw_events\n    | where eventName == \"user.register\"\n    | extend station=tostring(context.stationId)\n    | where isnotempty(station)\n    | summarize arg_max(timestamp, station) by userId;\nlet pool=\n    raw_events\n    | where eventName == \"game.start\"\n    | extend pool=tostring(context.poolName), session=tostring(properties.sessionId)\n    | summarize arg_max(timestamp, pool) by session;\nlet result =\n_todaysevents\n| where eventName == \"game.answerquestion\"\n| extend session=tostring(properties.sessionId)\n| lookup stationMap on userId\n| where isnotempty(station)\n| summarize arg_max(timestamp, *) by station\n| lookup pool on session\n| extend loc=case(\n    station == \"quantumqueryist\" or station == \"station-01\", \"1\",\n    station == \"dashboarddruid\" or station == \"station-02\", \"2\",\n    station == \"insightsalchemist\" or station == \"station-03\", \"3\",\n    \"\")\n| where loc == \"2\"\n| extend URL=case(\n    pool contains \"SQL\", \"https://i.postimg.cc/VNSwCjk3/sql.jpg\",\n    pool contains \"Fabric\", \"https://i.postimg.cc/WzVcCCwM/fabric.jpg\",\n    \"\")\n| extend FinalCard=iff(isnotempty(URL), strcat(\"![\", pool, \"](\", URL, \")\"), pool)\n| project FinalCard;\nresult\n| union (print FinalCard=\"Waiting for tagged players\" | where toscalar(result | count) == 0)",
      "id": "89c68714-ef74-4969-af7f-df404196cd03",
      "usedVariables": [
        "_todaysevents"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c5f76ee9-8b0b-4b09-914c-ab8f8984edd6"
      },
      "text": "let stationMap=\n    raw_events\n    | where eventName == \"user.register\"\n    | extend station=tostring(context.stationId)\n    | where isnotempty(station)\n    | summarize arg_max(timestamp, station) by userId;\nlet pool=\n    raw_events\n    | where eventName == \"game.start\"\n    | extend pool=tostring(context.poolName), session=tostring(properties.sessionId)\n    | summarize arg_max(timestamp, pool) by session;\nlet result =\n_todaysevents\n| where eventName == \"game.answerquestion\"\n| extend session=tostring(properties.sessionId)\n| lookup stationMap on userId\n| where isnotempty(station)\n| summarize arg_max(timestamp, *) by station\n| lookup pool on session\n| extend loc=case(\n    station == \"quantumqueryist\" or station == \"station-01\", \"1\",\n    station == \"dashboarddruid\" or station == \"station-02\", \"2\",\n    station == \"insightsalchemist\" or station == \"station-03\", \"3\",\n    \"\")\n| where loc == \"1\"\n| extend URL=case(\n    pool contains \"SQL\", \"https://i.postimg.cc/VNSwCjk3/sql.jpg\",\n    pool contains \"Fabric\", \"https://i.postimg.cc/WzVcCCwM/fabric.jpg\",\n    \"\")\n| extend FinalCard=iff(isnotempty(URL), strcat(\"![\", pool, \"](\", URL, \")\"), pool)\n| project FinalCard;\nresult\n| union (print FinalCard=\"Waiting for tagged players\" | where toscalar(result | count) == 0)",
      "id": "150cc80a-cd53-4481-ad45-685795a47b8d",
      "usedVariables": [
        "_todaysevents"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c5f76ee9-8b0b-4b09-914c-ab8f8984edd6"
      },
      "text": "let stationMap=\n    raw_events\n    | where eventName == \"user.register\"\n    | extend station=tostring(context.stationId)\n    | where isnotempty(station)\n    | summarize arg_max(timestamp, station) by userId;\nlet pool=\n    raw_events\n    | where eventName == \"game.start\"\n    | extend pool=tostring(context.poolName), session=tostring(properties.sessionId)\n    | summarize arg_max(timestamp, pool) by session;\nlet result =\n_todaysevents\n| where eventName == \"game.answerquestion\"\n| extend session=tostring(properties.sessionId)\n| lookup stationMap on userId\n| where isnotempty(station)\n| summarize arg_max(timestamp, *) by station\n| lookup pool on session\n| extend loc=case(\n    station == \"quantumqueryist\" or station == \"station-01\", \"1\",\n    station == \"dashboarddruid\" or station == \"station-02\", \"2\",\n    station == \"insightsalchemist\" or station == \"station-03\", \"3\",\n    \"\")\n| where loc == \"3\"\n| extend URL=case(\n    pool contains \"SQL\", \"https://i.postimg.cc/VNSwCjk3/sql.jpg\",\n    pool contains \"Fabric\", \"https://i.postimg.cc/WzVcCCwM/fabric.jpg\",\n    \"\")\n| extend FinalCard=iff(isnotempty(URL), strcat(\"![\", pool, \"](\", URL, \")\"), pool)\n| project FinalCard;\nresult\n| union (print FinalCard=\"Waiting for tagged players\" | where toscalar(result | count) == 0)",
      "id": "ed949a84-1441-4ae0-b22b-f61a2196db25",
      "usedVariables": [
        "_todaysevents"
      ]
    },
    {
      "text": "",
      "id": "2d0fc642-e491-4347-9d95-0288a39fc615",
      "usedVariables": []
    },
    {
      "id": "eb98abf5-6b9b-43bf-931d-145c54d402a4",
